<html-comment>product-list: for/in, define+call, ngClass/ngStyle, dynamic data-* attribute</html-comment>
<div class="product-list">
  <define/Row|k, v|>
    <li data-key=k class={featured: v.featured} style={opacity: v.featured ? 1 : 0.6}>
      ${k}: ${v.name} (price ${v.price})
    </li>
  </define>

  <ul style={color: textColor}>
    <for|k, v| in=products>
      <Row(k, v)/>
    </for>
  </ul>
</div>
