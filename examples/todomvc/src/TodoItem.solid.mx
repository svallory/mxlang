import { createSignal } from "solid-js";
import type { Todo } from "./types";

export function TodoItem(props: {
  todo: Todo;
  onToggle: (id: number) => void;
  onDestroy: (id: number) => void;
  onEdit: (id: number, text: string) => void;
}) {
  const [editing, setEditing] = createSignal(false);
  const [draft, setDraft] = createSignal("");
  let done = false;

  const startEdit = () => {
    done = false;
    setDraft(props.todo.text);
    setEditing(true);
  };

  const commitEdit = () => {
    if (done) return;
    done = true;
    const text = draft().trim();
    if (text.length === 0) {
      props.onDestroy(props.todo.id);
    } else {
      props.onEdit(props.todo.id, text);
    }
    setEditing(false);
  };

  const cancelEdit = () => {
    if (done) return;
    done = true;
    setEditing(false);
  };

  return (
    <li class={completed: props.todo.completed, editing: editing()}>
      <if=(!editing())>
        <div class="view">
          <input
            class="toggle"
            type="checkbox"
            checked=props.todo.completed
            onChange() { props.onToggle(props.todo.id) }
          />
          <label onDblClick() { startEdit() }>${props.todo.text}</label>
          <button class="destroy" onClick() { props.onDestroy(props.todo.id) }></button>
        </div>
      </if>
      <else>
        <input
          class="edit"
          ref(el) { el.focus() }
          value=draft()
          onInput(e) { setDraft(e.currentTarget.value) }
          onBlur() { commitEdit() }
          onKeyDown(e) {
            if (e.key === "Enter") commitEdit();
            if (e.key === "Escape") cancelEdit();
          }
        />
      </else>
    </li>
  );
}
