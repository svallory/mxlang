---
export interface Props {
  title: string;
}

const { title } = Astro.props as Props;
---
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>${title} — astro-static</title>
  </head>
  <body>
    <p class="mx-layout-marker">Rendered through BaseMx.astro.mx</p>
    <slot></slot>
  </body>
</html>
