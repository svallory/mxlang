import type { AttrTag } from "@mxlang/html";

export interface Input {
  title: string;
  content: () => string;
  footer?: AttrTag<{ as: "renderable" }, () => string>;
}

<article class="card">
  <h2>${input.title}</h2>
  <div class="card-body">$!{input.content()}</div>
  <if=input.footer>
    <footer class="card-footer">$!{input.footer()}</footer>
  </if>
</article>
