{
  "name": "@mxlang/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:home": "bun scripts/build-home.ts",
    "check:home": "bun scripts/build-home.ts --check",
    "dev": "bun run build:wasm && bun run build:home && docmd dev",
    "build": "bun run build:wasm && bun run build:home && docmd validate && docmd build && bun run check:home",
    "validate": "docmd validate",
    "test": "bun run build:wasm && vitest run",
    "preview": "npx serve site",
    "build:wasm": "bun run --cwd ../../packages/editors/tree-sitter-mx build:wasm && bash scripts/build-ts-grammar.sh"
  },
  "dependencies": {
    "@docmd/core": "0.9.5"
  },
  "devDependencies": {
    "@mxlang/angular": "workspace:*",
    "@mxlang/astro": "workspace:*",
    "@mxlang/core": "workspace:*",
    "@mxlang/hono": "workspace:*",
    "@mxlang/html": "workspace:*",
    "@mxlang/parser": "workspace:*",
    "@mxlang/preact": "workspace:*",
    "@mxlang/react": "workspace:*",
    "@mxlang/solid": "workspace:*",
    "@mxlang/tree-sitter-mx": "workspace:*",
    "tree-sitter-javascript": "0.23.1",
    "vitest": "3.2.7",
    "web-tree-sitter": "0.26.9"
  }
}
