import type { AttrTag } from "@mxlang/core";
import { money } from "../format.ts";
import type { Product } from "../product.ts";

export interface Input {
  product: Product;
  currency: string;
  featured?: boolean;
  /** An attribute tag: the caller writes `<@badge>…</@badge>`. */
  badge?: AttrTag;
  /** An attribute tag whose body takes `amount`: `<@price|amount|>`. */
  price?: AttrTag<{ content: (amount: number) => unknown }>;
}

<article class={ card: true, featured: input.featured } id=`product-${input.product.id}`>
  <if=input.badge><${input.badge}/></if>
  <h3>${input.product.name}</h3>
  <p>$!{input.product.blurb}</p>
  <p.tags>
    <for|tag| of=input.product.tags><span>#${tag}</span></for>
  </p>
  <${input.price?.content}(input.product.price)/>
</article>