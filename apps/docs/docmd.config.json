        { "title": "Region files: the rules", "path": "/hosts/region-files/" },
        {
          "title": "Solid",
          "path": "/hosts/solid/",
          "children": [
            {
              "title": "What MX compiles to",
              "path": "/hosts/solid/semantics/"
            }
          ]
        },
        {
          "title": "Astro",
          "path": "/hosts/astro/",
          "children": [
            {
              "title": "What MX compiles to",
              "path": "/hosts/astro/semantics/"
            },
            {
              "title": ".mx components and pages",
              "path": "/hosts/astro/mx-files/"
            }
          ]
        },
        {
          "title": "Angular",
          "path": "/hosts/angular/",
          "children": [
            { "title": ".ng.mx in detail", "path": "/hosts/angular/ng-mx/" },
            {
              "title": "What MX compiles to",
