          ]
        }
      ]
    },
    {
      "title": "Editors & Tooling",
      "icon": "keyboard",
      "children": [
        { "title": "Zed", "path": "/editors/zed/" },
        { "title": "VS Code", "path": "/editors/vscode/" },
        { "title": "Language server", "path": "/editors/language-server/" },
        { "title": "TypeScript", "path": "/editors/typescript/" }
      ]
    },
    {
      "title": "Architecture",
      "icon": "layout-grid",
      "children": [
        { "title": "Core and hosts", "path": "/architecture/core-and-hosts/" },
        { "title": "The IR", "path": "/architecture/ir/" },
        { "title": "IR specification", "path": "/architecture/ir-spec/" },
        { "title": "The MX AST", "path": "/architecture/ast/" },
        {
          "title": "Declarations and hooks",
          "path": "/architecture/policy-and-hooks/"
        },
        {
          "title": "Spans and mappings",
          "path": "/architecture/spans-and-mappings/"
        }
      ]
    },
    {
      "title": "Project",
      "icon": "git-branch",
      "children": [
        { "title": "Contributing", "path": "/contributing/" },
        { "title": "Divergences & MX 2", "path": "/divergences-and-mx-2/" },
        { "title": "Roadmap", "path": "/roadmap/" }
      ]
    },
    {
      "title": "Design notes",
      "icon": "lightbulb",
      "children": [
        {
          "title": "Why MX has no resume",
          "path": "/design-notes/marko-runtime-modes/"
        },
        {
          "title": "Arbitrary code in templates",
          "path": "/design-notes/arbitrary-code-in-templates/"
        },
        {
          "title": "MX vs JSX for framework authors",
          "path": "/design-notes/mx-vs-jsx/"
        },
        {
