{
  "title": "MX",
  "url": "https://mx.saulo.tech",
  "src": "docs",
  "out": "site",
  "engine": "js",
  "layout": {
    "spa": true,
    "header": { "enabled": true },
    "sidebar": { "collapsible": true, "defaultCollapsed": false },
    "optionsMenu": {
      "position": "sidebar-top",
      "components": { "search": true, "themeSwitch": true }
    },
    "footer": {
      "style": "minimal",
      "content": "MX is a template language born from Marko.",
      "branding": true
    }
  },
  "theme": {
    "name": "default",
    "appearance": "system",
    "codeHighlight": true,
    "customCss": ["/assets/css/home.css"]
  },
  "minify": true,
  "autoTitleFromH1": true,
  "copyCode": true,
  "markdown": { "breaks": false },
  "redirects": {
    "/hosts/": "/hosts/intro/",
    "/hosts/html/": "/targets/html/",
    "/hosts/data/": "/targets/data/",
    "/hosts/third-party-targets/": "/targets/third-party-targets/"
  },
  "pageNavigation": true,
  "navigation": [
    { "title": "Home", "path": "/", "icon": "house" },
    {
      "title": "Start Here: Introduction",
      "path": "/introduction/",
      "icon": "book-open"
    },
    {
      "title": "Language",
      "icon": "code",
      "children": [
        { "title": "Structural tags", "path": "/language/structural-tags/" },
        {
          "title": "Attributes",
          "path": "/language/attributes/"
        },
        {
          "title": "Atoms",
          "path": "/language/atoms/"
        },
        {
          "title": "Attribute tags and tag params",
          "path": "/language/attribute-tags-and-params/"
        },
        { "title": "AttrTag", "path": "/language/attr-tag/" },
        {
          "title": "Define, const, static, import",
          "path": "/language/define-const-static-import/"
        },
        {
          "title": "Interpolation and escaping",
          "path": "/language/interpolation/"
        },
        { "title": "Stateful tags", "path": "/language/stateful-tags/" },
        { "title": "Errors", "path": "/language/errors/" }
      ]
    },
    { "title": "Specification", "path": "/specification/", "icon": "scroll" },
    {
      "title": "Custom tags",
      "icon": "tags",
      "children": [
        { "title": "Overview", "path": "/custom-tags/" },
        { "title": "Template tags", "path": "/custom-tags/templates/" },
        { "title": "Sidecars", "path": "/custom-tags/sidecars/" },
        { "title": "Discovery", "path": "/custom-tags/discovery/" },
        {
          "title": "Writing a dialect package",
          "path": "/custom-tags/dialect-package/"
        },
        { "title": "Reference", "path": "/custom-tags/reference/" }
      ]
    },
    {
      "title": "Targets",
      "icon": "server",
      "children": [
        { "title": "HTML target", "path": "/targets/html/" },
        { "title": "Data target", "path": "/targets/data/" },
        {
          "title": "Third-party targets",
          "path": "/targets/third-party-targets/"
        }
      ]
    },
    {
      "title": "Hosts",
      "icon": "blocks",
      "children": [
        { "title": "Overview", "path": "/hosts/intro/" },
        {
          "title": "React",
          "path": "/hosts/react/",
          "children": [
            {
              "title": "What MX compiles to",
