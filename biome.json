{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/fixtures/**/__golden__",
      "!**/fixtures/**/*.solid.mx",
      "!apps/docs/example/hosts",
      "!apps/docs/example/ir-spec",
      "!**/fixtures/host-dispatch/bad-package-json",
      "!packages/core/src/fixtures/callee-input/parse-error.ts",
      "!**/fixtures-marko",
      "!**/fixtures/angular",
      "!**/.probe*",
      "!packages/babel/src/{parser,plugins,tokenizer,util,parse-error}",
      "!packages/babel/src/{index,options,parse-error,plugin-utils,types}.ts",
      "!packages/babel/src/typings.d.ts",
      "!packages/parser/src/template/{core,states,util,__tests__}",
      "!packages/parser/src/template/index.ts",
      "!packages/parser/src/template/internal.ts",
      "!packages/tsx-bridge/dist",
      "!packages/editors/tree-sitter-solid/vendor",
      "!packages/editors/tree-sitter-solid/src",
      "!packages/editors/tree-sitter-solid/test/corpus",
      "!packages/editors/tree-sitter-solid/fixtures",
      "!packages/editors/tree-sitter-amx/src",
      "!packages/editors/tree-sitter-amx/test/corpus",
      "!packages/editors/tree-sitter-mx/src",
      "!packages/editors/tree-sitter-mx/grammar.js",
      "!packages/editors/tree-sitter-mx/tree-sitter.json",
      "!packages/editors/tree-sitter-mx/__tests__",
      "!packages/editors/tree-sitter-mx/tools"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/fixtures/**/twin.tsx"],
      "linter": {
        "rules": {
          "a11y": { "useButtonType": "off" }
        }
      }
    },
    {
      "includes": ["examples/astro-static/**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/hosts/astro/src/astro-template.test.ts",
        "packages/hosts/astro/src/astro-template.ts",
        "packages/hosts/astro/src/server.test.ts",
        "packages/hosts/astro/src/vite-pages.test.ts",
        "packages/hosts/astro/src/vite-pages.ts",
        "packages/core/src/compile.ts",
        "packages/core/src/core.ts",
        "packages/core/src/emit-statement.test.ts",
        "packages/core/src/hooks.test.ts",
        "packages/hosts/preact/src/emitter.ts",
        "packages/hosts/preact/src/index.test.ts",
        "packages/hosts/hono/src/try-typecheck.test.ts",
        "packages/targets/html/scripts/consumer-check.ts",
        "packages/tooling/language-server/src/diagnose.test.ts",
        "packages/core/src/template-tag.ts",
        "packages/core/src/template-tag.test.ts",
        "packages/hosts/angular/src/emitter.ts",
        "packages/hosts/angular/src/literal-syntax-hint.ts",
        "packages/hosts/angular/test/cli.test.ts",
        "packages/hosts/angular/test/component.test.ts",
        "packages/hosts/angular/test/control-flow.test.ts",
        "packages/hosts/angular/test/define.test.ts",
        "packages/hosts/angular/test/for.test.ts",
        "packages/hosts/angular/test/literal-syntax-hint.test.ts",
        "packages/hosts/angular/test/ng-mx-anchors.test.ts",
        "packages/hosts/angular/test/tag-module.test.ts",
        "packages/hosts/angular/test/text-interpolation.test.ts",
        "packages/parser/src/frontend/rules.ts",
        "packages/parser/src/frontend/rules.test.ts",
        "packages/parse-differential/src/differential.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": { "noTemplateCurlyInString": "off" }
        }
      }
    },
    {
      "includes": ["packages/core/src/compile.ts", "packages/core/src/core.ts"],
      "linter": {
        "rules": {
          "style": { "useNamingConvention": "on" },
          "suspicious": { "noExplicitAny": "off" }
        }
      }
    },
    {
      "includes": ["packages/targets/html/src/translate.test.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noTemplateCurlyInString": "info" }
        }
      }
    }
  ]
}
