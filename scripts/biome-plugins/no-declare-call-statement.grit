// Bun 1.3.14 (the CI pin) erases every expression statement whose first token
// is `declare` (`declare(x);`, `declare?.(x);`, `declare.call(null, x);`,
// `declare(x) + 1;`, ...) as an ambient declaration, under `bun run`,
// `bun test` and `bun build`. Without a semicolon it also erases the statement
// after it. Fixed in Bun 1.4.2.
// Kept on 1.3.14, so not matched: `x.declare()`, `const y = declare(x)`,
// `(declare)(x);`, `void declare(x);`, `await declare(x);`, `declareX(x);`.
JsExpressionStatement() as $statement where {
  $statement <: r"declare(?:[^A-Za-z0-9_$][\s\S]*)?",
  register_diagnostic(span=$statement, message="Bun 1.3.14's TypeScript transpiler erases a statement that starts with `declare` as an ambient declaration (and, without a semicolon, the statement after it). Rename the helper.", severity="error")
}
