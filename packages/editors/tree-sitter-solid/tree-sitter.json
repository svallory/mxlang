{
  "grammars": [
    {
      "name": "solid",
      "camelcase": "Solid",
      "scope": "source.solid",
      "path": ".",
      "external-files": [
        "src/scanner_mx.c",
        "vendor/tree-sitter-typescript/common/scanner.h"
      ],
      "file-types": ["solid.mx"],
      "highlights": ["queries/highlights.scm"],
      "injection-regex": "^(solid|solid\\.mx)$"
    }
  ],
  "metadata": {
    "version": "0.0.0",
    "license": "MIT",
    "description": "tree-sitter grammar for Solid (.solid.mx)",
    "authors": [
      {
        "name": "mx contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/svallory/mxlang"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
