{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mx",
      "camelcase": "Mx",
      "title": "MX",
      "scope": "source.mx",
      "path": ".",
      "file-types": [
        "mx"
      ],
      "injection-regex": "^mx$",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for MX (Marko syntax plus the decision 146 name sugar), vendored from marko-js/tree-sitter",
    "links": {
      "repository": "https://github.com/svallory/mxlang"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
