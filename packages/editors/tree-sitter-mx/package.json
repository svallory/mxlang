{
  "name": "@mxlang/tree-sitter-mx",
  "version": "0.1.0-alpha.1",
  "description": "Tree-sitter grammar for MX (.mx): wasm build, highlight and injection queries, and a docmd plugin that highlights ```mx fences at build time",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/svallory/mxlang",
    "directory": "packages/editors/tree-sitter-mx"
  },
  "keywords": [
    "mx",
    "marko",
    "tree-sitter",
    "syntax-highlighting",
    "docmd"
  ],
  "//type": "No \"type\" field on purpose: tree-sitter loads grammar.js as CommonJS, and \"type\": \"module\" makes its require() call fail. Upstream's package.json omits it for the same reason. The shipped JS is .mjs, which is ESM either way.",
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.3"
  },
  "types": "highlight/index.d.mts",
  "exports": {
    ".": {
      "types": "./highlight/index.d.mts",
      "default": "./highlight/index.mjs"
    },
    "./docmd": {
      "types": "./highlight/mx-highlight.d.mts",
      "default": "./highlight/mx-highlight.mjs"
    },
    "./tree-sitter-mx.wasm": "./tree-sitter-mx.wasm",
    "./queries/highlights.scm": "./queries/highlights.scm",
    "./queries/injections.scm": "./queries/injections.scm",
    "./package.json": "./package.json"
  },
  "files": [
    "tree-sitter-mx.wasm",
    "queries",
    "highlight",
    "src",
    "grammar.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "flock /tmp/mx-zed-generate.lock bunx tree-sitter generate",
    "build:wasm": "flock /tmp/mx-zed-generate.lock bunx tree-sitter build --wasm -o tree-sitter-mx.wasm",
    "build:ts-grammar": "bash highlight/build-ts-grammar.sh",
    "prepack": "bun run build:wasm && bun run build:ts-grammar",
    "test": "./scripts/test.sh",
    "vendor:check": "./scripts/vendor-check.sh",
    "zed-compile-check": "./scripts/zed-compile-check.sh"
  },
  "dependencies": {
    "web-tree-sitter": "0.26.9"
  },
  "//peerDependencies": "web-tree-sitter's own declarations use the global EmscriptenModule type, so a TypeScript consumer that typechecks node_modules (skipLibCheck: false) and imports the /docmd types needs @types/emscripten loaded. Optional: the runtime never needs it.",
  "peerDependencies": {
    "@types/emscripten": "^1.40.0"
  },
  "peerDependenciesMeta": {
    "@types/emscripten": {
      "optional": true
    }
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.9",
    "tree-sitter-javascript": "0.23.1"
  }
}
