         continue;
       }
@@ -1092,7 +1148,7 @@ static bool scan_expr_inner(EStream *es, ExprState *e) {
           }
           e->ternary_depth++;
           es_next(es);
-          es_consume_ws(es);
+          es_consume_ws(es, e);
