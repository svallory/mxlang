+++ b/__tests__/util/tree-events.mts
@@ -188,6 +188,12 @@ export function treeEvents(src: string, root: SyntaxNode): Event[] {
         flushAttr();
       }
       switch (part.type) {
+        // MX: attribute-position shorthands (`<a x=1 #b .c :d>`). Where
+        // htmljs-parser accepts them it reads an attribute named `#b`/`.c`/
