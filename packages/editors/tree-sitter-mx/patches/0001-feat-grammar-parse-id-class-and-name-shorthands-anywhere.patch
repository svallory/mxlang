+        case "shorthand_id":
+        case "shorthand_class":
+        case "shorthand_name":
         case "attr_name":
           flushAttr();
           cur = { name: part };
@@ -313,6 +319,9 @@ export function treeEvents(src: string, root: SyntaxNode): Event[] {
     };
 
     let tagPartsSeenAttr = false;
+    // End of the tag name and its adjacent shorthands; a shorthand starting
+    // anywhere else is in attribute position.
+    let nameEnd = -1;
 
     for (const child of kids) {
       switch (child.type) {
@@ -321,6 +330,7 @@ export function treeEvents(src: string, root: SyntaxNode): Event[] {
           break;
         case "tag_name":
           tagNameNode = child;
+          nameEnd = child.endIndex;
           addTemplate(
