{
  "name": "vscode",
  "displayName": "MX",
  "description": "MX, AstroMX and SolidMX language support.",
  "version": "0.0.0",
  "private": true,
  "publisher": "mxlang",
  "engines": {
    "vscode": "^1.90.0"
  },
  "type": "commonjs",
  "main": "dist/extension.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../../.. --project @mxlang/vscode",
    "build": "bun build src/extension.ts --outdir dist --target node --format cjs --entry-naming '[dir]/[name].cjs' --external vscode",
    "package": "bun run build && bun run --cwd ../../tooling/typescript-plugin build:bundled && bun ../../tooling/language-server/build/bundled.ts && bun run scripts/stage-vsix.ts",
    "check-vsix": "bun run scripts/check-vsix.ts mxlang.vsix",
    "tsserver-load": "bun run scripts/tsserver-load.ts mxlang.vsix",
    "ls-smoke": "node scripts/ls-smoke.mts mxlang.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.9.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "MX loads the target, sidecar and contracts modules that a project's package.json names (require) when a .mx file is opened or compiled, which runs project code. Trust the workspace to enable it."
    }
  },
  "activationEvents": [
    "onLanguage:mx",
    "onLanguage:solidmx",
    "onLanguage:astromx",
    "onLanguage:ngmx"
  ],
  "extensionDependencies": [
    "Marko-JS.marko-vscode"
  ],
  "contributes": {
    "languages": [
      {
        "id": "solidmx",
        "aliases": [
          "SolidMX",
          "solidmx"
        ],
        "extensions": [
          ".solid.mx"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ngmx",
        "aliases": [
          "AngularMX",
          "ngmx"
        ],
        "extensions": [
          ".ng.mx"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "mx",
        "aliases": [
          "MX",
          "mx"
        ],
        "extensions": [
          ".mx"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "astromx",
        "aliases": [
          "AstroMX",
          "astromx"
        ],
        "extensions": [
          ".astro.mx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mx",
        "scopeName": "source.mx",
        "path": "./syntaxes/mx.tmLanguage.json"
      },
      {
        "language": "astromx",
        "scopeName": "source.astromx",
        "path": "./syntaxes/astromx.tmLanguage.json"
      },
      {
        "language": "solidmx",
        "scopeName": "source.solidmx",
        "path": "./syntaxes/solidmx.tmLanguage.json"
      },
      {
        "language": "ngmx",
        "scopeName": "source.ngmx",
        "path": "./syntaxes/ngmx.tmLanguage.json"
      }
    ],
    "typescriptServerPlugins": [
      {
        "name": "@mxlang/typescript-plugin",
        "enableForWorkspaceTypeScriptVersions": true,
        "languages": [
          "mx",
          "solidmx",
          "ngmx",
          "astromx"
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "MX",
      "properties": {
        "mxlang.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to an @mxlang/language-server executable that overrides the language server bundled with this extension. Leave empty to use the bundled one."
        }
      }
    },
    "commands": [
      {
        "command": "mxlang.restartLanguageServer",
        "title": "MX: Restart Language Server"
      }
    ]
  }
}
