{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    // Typecheck-only (the bundle is built by `bun build`, which keeps the
    // plugin external). The plugin resolves from its src here, so no
    // typecheck path needs a prebuilt (or fresh) plugin dist; the plugin's
    // published `types` still points at dist. `rootDir` covers the plugin's
    // src and the private host src it imports (TS6059 otherwise).
    "rootDir": "../..",
    "paths": {
      "@mxlang/typescript-plugin": ["../typescript-plugin/src/index.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  "exclude": ["src/fixtures"]
}
