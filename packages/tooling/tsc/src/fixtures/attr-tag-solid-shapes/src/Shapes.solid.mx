import type { AttrTag } from "@mxlang/host-solid";

export interface Input {
  tab?: AttrTag<{ title: string; sub?: AttrTag<{ size: number }> }>;
  rows?: AttrTag<{ id: number }>;
  row?: AttrTag<{ content: (count: number) => unknown }>;
}
export default function Shapes(_input: Input): JSX.Element {
  return <div/>;
}
