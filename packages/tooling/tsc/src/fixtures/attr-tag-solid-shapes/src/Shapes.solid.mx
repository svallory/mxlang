import type { AttrTag } from "@mxlang/solid";

export interface Input {
  tab?: AttrTag<{ attrs: { title: string; sub?: AttrTag<{ attrs: { size: number } }> } }>;
  rows?: AttrTag<{ attrs: { id: number } }>[];
  row?: AttrTag<{ as: "renderable"; params: [count: number] }>;
}
export default function Shapes(_input: Input): JSX.Element {
  return <div/>;
}
