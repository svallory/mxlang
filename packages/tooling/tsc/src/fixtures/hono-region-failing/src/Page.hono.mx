import { useState } from "hono/jsx";
import Card from "./Card.hono.mx";

export function Page() {
  const [label] = useState(0);
  return (
    <section>
      <Card>
        <@row|count|>
          <strong>${count.toUpperCase()}</strong>
        </@row>
      </Card>
      <p title=label.trim()>${label}</p>
    </section>
  );
}
