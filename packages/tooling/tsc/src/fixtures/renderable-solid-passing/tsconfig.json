{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@mxlang/host-solid": ["../../../../../hosts/solid/src/index.ts"],
      "@mxlang/core": ["../../../../../core/src/index.ts"],
      "@mxlang/tsx-bridge": ["../../../../../tsx-bridge/src/public.d.ts"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"]
}
