import Card from "./Card.solid.mx";

export const text = <Card><@b>B</@b></Card>;
export const element = <Card><@b><strong>B</strong></@b></Card>;
export const row = (
  <Card>
    <@row|count|>
      <strong>${count.toFixed(1)}</strong>
    </@row>
  </Card>
);
export const maybe = (show: boolean) => (
  <Card>
    <if=show>
      <@b><strong>B</strong></@b>
    </if>
  </Card>
);
