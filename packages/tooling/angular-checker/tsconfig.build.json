{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    // Declarations resolve the workspace deps through their published `types`
    // (dist), not the typecheck-only src mapping in tsconfig.json.
    "paths": {},
    "declarationMap": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/fixtures/**"]
}
