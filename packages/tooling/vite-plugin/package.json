{
  "name": "@mxlang/vite-plugin",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.3"
  },
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build/runtime.ts && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vite": ">=8.2.2 <9"
  },
  "dependencies": {
    "@marko/compiler": "5.42.5",
    "@mxlang/core": "workspace:*",
    "@mxlang/parser": "workspace:*",
    "@mxlang/target-registry": "workspace:*"
  },
  "devDependencies": {
    "@mxlang/html": "workspace:*"
  }
}
