{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/fixtures/**",
    // The forked worker entry: bundled as `dist/ng-worker.cjs`, never imported
    // by the plugin, so its declaration must not be emitted (the build strips
    // `ng-diagnostics.d.ts` the same way — see build/strip-ng-declarations.ts).
    "src/ng-worker.ts",
    // Internal registry-typed glue, not a public API. Imports can still pull
    // it into tsc's program despite exclude; the guarded strip removes it.
    "src/file-kinds.ts"
  ]
}
