{
  "name": "@mxlang/data",
  "version": "0.1.0-alpha.12",
  "description": "MX's data target: parse a .mx file into a static tree of tags, attributes and text",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/svallory/mxlang",
    "directory": "packages/targets/data"
  },
  "keywords": [
    "mx",
    "marko",
    "data",
    "parser",
    "dsl"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.3"
  },
  "main": "dist/parse.js",
  "types": "dist/parse.d.ts",
  "exports": {
    ".": {
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    },
    "./descriptor": {
      "types": "./dist/descriptor.d.ts",
      "default": "./dist/descriptor.js"
    },
    "./tree": {
      "types": "./dist/tree.d.ts",
      "default": "./dist/tree.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/parse.ts src/descriptor.ts src/tree.ts --outdir dist --target node --format esm --external @marko/compiler --external @mxlang/core && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/types": "7.29.8",
    "@mxlang/core": "workspace:*"
  }
}
