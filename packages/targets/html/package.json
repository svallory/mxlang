{
  "name": "@mxlang/html",
  "version": "0.1.0",
  "description": "Compiles a .mx template to a runtime-free (input) => string function",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/svallory/mxlang",
    "directory": "packages/targets/html"
  },
  "keywords": [
    "marko",
    "template",
    "translator",
    "ssr",
    "html"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.3"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./descriptor": {
      "types": "./dist/descriptor.d.ts",
      "default": "./dist/descriptor.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./types/marko": "./types/marko.d.ts"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun --tsconfig-override=../../../tsconfig.base.json test src/bun.test.ts src/helpers.bun.test.ts src/example.bun.test.ts src/marko-tags.bun.test.ts src/contracts.bun.test.ts",
    "build": "rm -rf dist && bun build src/index.ts src/bun.ts src/descriptor.ts src/runtime.ts --outdir dist --target node --format esm --external @babel/parser --external @marko/compiler --external @mxlang/core && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "example": "bun src/example.ts"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@mxlang/core": "workspace:*"
  },
  "peerDependencies": {
    "@types/bun": ">=1.3"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    }
  },
  "devDependencies": {
    "@marko/compiler": "5.42.11",
    "@types/bun": "1.4.2"
  }
}
