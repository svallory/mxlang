<define/One|a, ...rest|><div>${a}:<${rest[0]?.content}/></div></define>
<define/Two|a, ...rest|><div>${a}:${rest[0]}:<${rest[1]?.content}/></div></define>
<define/Three|a, ...rest|><div>${a}:${rest[0]}:${rest[1]}:<${rest[2]?.content}/></div></define>
<define/Bare|a, ...rest|><div>${a}:${rest[0]}:${rest[1]?.content ? "object" : "none"}</div></define>
<define/Tagged|a, ...rest|><div>${a}:${rest[0]}:<${rest[1]?.item}/>:<${rest[1]?.content}/>:${Object.keys(rest[1] ?? {}).sort().join(",")}</div></define>

<One(1)>x</One>
<Two(1, 2)>x</Two>
<Three(1, 2, 3)>x</Three>
<Bare(input.n, 2)/>
<Tagged(1, 2)><@item>I</@item>x</Tagged>
