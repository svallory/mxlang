import { Customer } from "./customer.mesh.mx"

entity :Invoice
  attributes
    uuid :id primary-key
    date :dueOn
    timestamp :insertedAt on=:create

  relationships
    belongs-to :customer entity=Customer

  actions
    read :forCustomer
      input
        uuid :customerId
      filter=({ input }) => &customer.id === input.customerId
      sort
        asc &dueOn
        desc &insertedAt
