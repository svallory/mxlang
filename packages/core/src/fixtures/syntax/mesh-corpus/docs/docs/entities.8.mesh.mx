import { User } from "./user.mesh.mx"

entity :Todo
  attributes
    uuid :id primary-key
    string :title min=1

  relationships
    belongs-to :owner entity=User

  actions
    create :create
      input
        &title
        &owner
      validate
        check :underQuota [
          that=() => &owner.todoCount < 20
          when=() => &owner.plan === :free
          code="quota_exceeded"
          message="free plan allows 20 todos"
        ]
