{
  "name": "@mxlang/core",
  "version": "0.1.0-alpha.15",
  "description": "MX core: parses and lowers .mx templates to a host-independent IR, shared by every target",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/svallory/mxlang",
    "directory": "packages/core"
  },
  "keywords": [
    "mx",
    "marko",
    "template",
    "compiler"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.3"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./syntax/member": {
      "types": "./dist/syntax/member.d.ts",
      "default": "./dist/syntax/member.js"
    },
    "./syntax/atoms-sugars": {
      "types": "./dist/syntax/atoms-sugars.d.ts",
      "default": "./dist/syntax/atoms-sugars.js"
    },
    "./syntax/mesh": {
      "types": "./dist/syntax/mesh.d.ts",
      "default": "./dist/syntax/mesh.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/syntax/member.ts src/syntax/atoms-sugars.ts src/syntax/mesh.ts --outdir dist --target node --format esm --external @marko/compiler --external @babel/parser --external htmljs-parser --define MX_MARKO_FRONTEND='\"./marko-frontend.cjs\"' && bun build/frontend.ts && bun build/third-party-notices.ts && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "7.29.8"
  },
  "devDependencies": {
    "@marko/compiler": "5.42.11",
    "@mxlang/babel": "workspace:*",
    "@mxlang/parser": "workspace:*",
    "htmljs-parser": "5.18.0"
  }
}
