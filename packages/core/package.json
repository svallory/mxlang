{
  "name": "@mxlang/core",
  "version": "0.1.0-alpha.1",
  "description": "MX core: compiles .mx templates on Marko's parser, shared by every target",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/svallory/mxlang",
    "directory": "packages/core"
  },
  "keywords": [
    "mx",
    "marko",
    "template",
    "compiler"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.3"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target node --format esm --external @marko/compiler --external @babel/parser --external htmljs-parser && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@marko/compiler": "5.42.5",
    "htmljs-parser": "5.15.0"
  }
}
