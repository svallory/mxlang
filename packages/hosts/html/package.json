{
  "name": "@mxlang/html",
  "version": "0.1.0",
  "description": "Compiles a .mx template to a runtime-free (input) => string function",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mxlang/mx",
    "directory": "packages/hosts/html"
  },
  "keywords": [
    "marko",
    "template",
    "translator",
    "ssr",
    "html"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.3"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun --tsconfig-override=../../../tsconfig.base.json test src/bun.test.ts src/helpers.bun.test.ts",
    "build": "rm -rf dist && bun build src/index.ts src/bun.ts src/example.ts --outdir dist --target node --format esm --external @marko/compiler --external @mxlang/core && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "example": "bun run build && node dist/example.js $@"
  },
  "dependencies": {
    "@marko/compiler": "5.42.5",
    "@mxlang/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.2"
  }
}
