{
  "name": "@mxlang/hono",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.3"
  },
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./descriptor": "./src/descriptor.ts",
    "./runtime": "./src/runtime.ts",
    "./bun": "./src/bun.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun --tsconfig-override=../../../tsconfig.base.json test src/bun.test.ts"
  },
  "dependencies": {
    "@mxlang/core": "workspace:*",
    "@mxlang/preact": "workspace:*"
  },
  "peerDependencies": {
    "hono": "4.6.20"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "hono": "4.6.20",
    "jsdom": "30.1.1"
  }
}
