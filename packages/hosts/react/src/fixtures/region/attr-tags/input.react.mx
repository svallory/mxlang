import type { ReactNode } from "react";

function Card(props: { header?: ReactNode; footer?: { content?: ReactNode; align: string }; children?: ReactNode }) {
  return (
    <div class="card">
      <h2>${props.header}</h2>
      ${props.children}
      <if=props.footer><small data-align=props.footer.align>${props.footer.content}</small></if>
    </div>
  );
}

export default function Page() {
  return (<>
    <Card>
      <@header>Items</@header>
      <@footer align="end">total</@footer>
      <p>body</p>
    </Card>
  </>);
}
