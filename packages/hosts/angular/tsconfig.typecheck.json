{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Used only by `typecheck` (`tsc -p tsconfig.typecheck.json`;
    // `tsconfig.build.json` pins `rootDir: src` for the declarations, and the
    // bundle is built by `bun build` with the workspace deps external). The
    // workspace deps resolve from their src here, so no typecheck path needs a
    // prebuilt (or fresh) dist; the published `types` still point at dist.
    // NOT in tsconfig.json: Bun's runtime honours the nearest tsconfig's
    // `paths`, so `bun dist/bin.js` (the angular-app example's build) would
    // load `@mxlang/core` from src, whose static `@mxlang/parser/frontend`
    // import reaches `@mxlang/babel`'s decorator source, which Bun cannot
    // parse (port PR 5). The parser maps to its hand-written `public.d.ts`
    // (its vendored Babel src needs relaxed flags), as vite-plugin does.
    // `@mxlang/angular` itself is imported by the oracle report the mapping
    // test reuses. `rootDir` covers the deps' src (TS6059 otherwise).
    "rootDir": "../../..",
    "paths": {
      "@mxlang/core": ["../../core/src/index.ts"],
      "@mxlang/tsx-bridge": ["../../tsx-bridge/src/public.d.ts"],
      "@mxlang/angular": ["./src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src", "test"]
}
