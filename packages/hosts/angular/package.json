{
  "name": "@mxlang/angular",
  "version": "0.1.0",
  "description": "Compiles a .mx template to an Angular template",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mxlang/mx",
    "directory": "packages/hosts/angular"
  },
  "keywords": [
    "marko",
    "template",
    "translator",
    "angular"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.3"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mx-angular": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "rm -rf dist && bun build src/index.ts src/bin.ts --outdir dist --target node --format esm --external @marko/compiler --external @mxlang/core && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist"
  },
  "dependencies": {
    "@marko/compiler": "5.42.5",
    "@mxlang/core": "workspace:*",
    "@mxlang/parser": "workspace:*",
    "magic-string": "0.30.21"
  },
  "devDependencies": {
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
